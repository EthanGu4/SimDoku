# openapi-typescript 7.13.0 (the latest) still declares its peer as
# typescript@^5.x, and this project is on TypeScript 6. The incompatibility is
# only in the metadata: type generation works fine against TS 6, and it is
# exercised on every `npm run gen:types`.
#
# This lives here rather than as a flag on individual commands so local
# installs, CI, and the Docker build all resolve the tree identically. Without
# it `npm ci` fails outright with ERESOLVE, which is a much worse failure mode
# than a stale peer range. Revisit when openapi-typescript widens the range.
legacy-peer-deps=true
